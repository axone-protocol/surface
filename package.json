{
    "name": "axone-surface",
    "version": "0.0.0",
    "description": "Public interface to the Axone protocol, making governed situations readable through an innovative web interface.",
    "private": true,
    "license": "BSD-3-Clause",
    "type": "module",
    "packageManager": "pnpm@11.4.0",
    "scripts": {
        "dev": "vite",
        "build": "run-s type-check build-only",
        "preview": "vite preview",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "capture:website": "node scripts/capture-website.mjs",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "run-s lint:eslint lint:oxlint format:check",
        "lint:fix": "run-s lint:eslint:fix lint:oxlint:fix format",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix --cache",
        "lint:oxlint": "oxlint .",
        "lint:oxlint:fix": "oxlint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "run-s lint test:unit build"
    },
    "dependencies": {
        "@cosmjs/proto-signing": "0.38.1",
        "@cosmjs/stargate": "0.38.1",
        "@vueuse/core": "^14.4.0",
        "bech32": "^2.0.0",
        "cosmjs-types": "0.11.0",
        "motion-v": "^2.3.0",
        "pixi.js": "^8.19.0",
        "vue": "^3.5.38",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^24.13.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/eslint-plugin": "^1.6.20",
        "@vue/eslint-config-typescript": "^14.8.0",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-oxlint": "~1.69.0",
        "eslint-plugin-playwright": "^2.10.4",
        "eslint-plugin-vue": "~10.9.2",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "npm-run-all2": "^9.0.2",
        "oxlint": "~1.69.0",
        "prettier": "3.8.4",
        "typescript": "~6.0.0",
        "vite": "^8.0.16",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^4.1.9",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.5"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
